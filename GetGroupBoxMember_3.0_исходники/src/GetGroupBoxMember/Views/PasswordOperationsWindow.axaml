<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GetGroupBoxMember.ViewModels"
        x:Class="GetGroupBoxMember.Views.PasswordOperationsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Операции с паролем"
        Width="520"
        Height="600"
        MinWidth="420"
        MinHeight="500"
        Background="{DynamicResource ThemeBackground}"
        WindowStartupLocation="CenterScreen">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="12">
    <StackPanel Spacing="10">

      <!-- Section 1: Password Status -->
      <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="🔑 Пароль учётной записи"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeTextPrimary}"/>

          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2">
              <TextBlock Text="Последняя смена:" FontSize="11"
                         Foreground="{DynamicResource ThemeTextSecondary}"/>
              <TextBlock Text="{Binding PasswordLastSetText}" FontSize="13"
                         Foreground="{DynamicResource ThemeMenuForeground}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="2">
              <TextBlock Text="Истекает:" FontSize="11"
                         Foreground="{DynamicResource ThemeTextSecondary}"/>
              <TextBlock Text="{Binding PasswordExpiryText}" FontSize="13"
                         Foreground="{DynamicResource ThemeMenuForeground}"/>
            </StackPanel>
            <StackPanel Grid.Column="0" Grid.Row="1" Spacing="2" Margin="0,4,0,0">
              <TextBlock Text="Требует смены:" FontSize="11"
                         Foreground="{DynamicResource ThemeTextSecondary}"/>
              <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                      Background="{DynamicResource StatusOrange}"
                      IsVisible="{Binding PasswordRequireChange}">
                <TextBlock Text="⚠ ДА" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextOnElevated}"/>
              </Border>
              <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                      Background="{DynamicResource StatusGreen}"
                      IsVisible="{Binding !PasswordRequireChange}">
                <TextBlock Text="✓ Нет" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextOnElevated}"/>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2" Margin="0,4,0,0">
              <TextBlock Text="Не истекает:" FontSize="11"
                         Foreground="{DynamicResource ThemeTextSecondary}"/>
              <TextBlock Text="{Binding PasswordNeverExpiresText}" FontSize="13"
                         Foreground="{DynamicResource ThemeMenuForeground}"/>
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Classes="ActionButton" Command="{Binding ChangePasswordCommand}"
                    IsEnabled="{Binding IsAdActionEnabled}" MinWidth="140">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="🔑" FontSize="13"/>
                <TextBlock Text="Сменить пароль" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button Classes="ActionButton" Command="{Binding RefreshPasswordStatusCommand}"
                    IsEnabled="{Binding HasSelectedUser}" MinWidth="120">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="🔄" FontSize="13"/>
                <TextBlock Text="Обновить" FontSize="12"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Section 2: Lock Status -->
      <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="🔒 Блокировка учётной записи"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeTextPrimary}"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Состояние:" FontSize="13"
                       Foreground="{DynamicResource ThemeTextSecondary}"
                       VerticalAlignment="Center"/>
            <Border CornerRadius="4" Padding="6,2"
                    Background="{DynamicResource StatusRed}"
                    IsVisible="{Binding IsLockedOut}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="🔒" FontSize="11"/>
                <TextBlock Text="ЗАБЛОКИРОВАНА" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextOnElevated}"/>
              </StackPanel>
            </Border>
            <Border CornerRadius="4" Padding="6,2"
                    Background="{DynamicResource StatusGreen}"
                    IsVisible="{Binding !IsLockedOut}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="✓" FontSize="11"/>
                <TextBlock Text="Активна" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextOnElevated}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <Button Classes="ActionButton" Command="{Binding UnlockAccountCommand}"
                  IsEnabled="{Binding IsUnlockEnabled}" MinWidth="160"
                  Margin="0,4,0,0">
            <Panel>
              <StackPanel Orientation="Horizontal" Spacing="6"
                          IsVisible="{Binding !IsAdOperationInProgress}">
                <TextBlock Text="🔓" FontSize="13"/>
                <TextBlock Text="Разблокировать УЗ" FontSize="12"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6"
                          IsVisible="{Binding IsAdOperationInProgress}">
                <ProgressBar Classes="ActionProgress" IsIndeterminate="True"
                             Width="60" Height="3"/>
                <TextBlock Text="Разблокировка..." FontSize="11"
                           Foreground="{DynamicResource ThemeTextSecondary}"/>
              </StackPanel>
            </Panel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Section 3: Force Password Change Flag -->
      <Border Background="{DynamicResource ThemeCardBackground}" CornerRadius="8" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="⚡ Смена пароля при следующем входе"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeTextPrimary}"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Флаг:" FontSize="13"
                       Foreground="{DynamicResource ThemeTextSecondary}"
                       VerticalAlignment="Center"/>
            <Border CornerRadius="4" Padding="6,2"
                    Background="{DynamicResource StatusOrange}"
                    IsVisible="{Binding PasswordRequireChange}">
              <TextBlock Text="⚠ УСТАНОВЛЕН" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource ThemeTextOnElevated}"/>
            </Border>
            <Border CornerRadius="4" Padding="6,2"
                    Background="{DynamicResource ThemeTextSecondary}"
                    IsVisible="{Binding !PasswordRequireChange}">
              <TextBlock Text="НЕ установлен" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource ThemeTextOnElevated}"/>
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Classes="ActionButton" Command="{Binding ForcePasswordChangeCommand}"
                    CommandParameter="True"
                    IsEnabled="{Binding IsAdActionEnabled}" MinWidth="160">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="⚠" FontSize="13"/>
                <TextBlock Text="Требовать смену" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button Classes="ActionButton" Command="{Binding ForcePasswordChangeCommand}"
                    CommandParameter="False"
                    IsEnabled="{Binding IsAdActionEnabled}" MinWidth="160">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="✓" FontSize="13"/>
                <TextBlock Text="Снять требование" FontSize="12"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Window>
