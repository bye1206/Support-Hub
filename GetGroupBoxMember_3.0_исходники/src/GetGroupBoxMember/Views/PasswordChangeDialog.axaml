<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GetGroupBoxMember.ViewModels"
        x:Class="GetGroupBoxMember.Views.PasswordChangeDialog"
        x:DataType="vm:PasswordChangeDialogViewModel"
        Title="Смена пароля"
        Width="480" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource ThemeBackground}">

  <Border Padding="24">
    <StackPanel Spacing="16">

      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="🔑" FontSize="24" VerticalAlignment="Center"/>
        <TextBlock Text="Смена пароля учётной записи"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextPrimary}"/>
      </StackPanel>

      <Border Background="{DynamicResource ThemeCardBackground}"
              CornerRadius="8" Padding="12">
        <StackPanel Spacing="4">
          <TextBlock Text="Пользователь:" FontSize="11"
                     Foreground="{DynamicResource ThemeTextSecondary}"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="👤" FontSize="13"/>
            <TextBlock Text="{Binding TargetDisplayName}" FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeTextPrimary}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="🔗" FontSize="13"/>
            <TextBlock Text="{Binding TargetLogin}" FontSize="13"
                       Foreground="{DynamicResource LinkColor}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Spacing="8">
        <TextBlock Text="Новый пароль:" FontSize="13"
                   Foreground="{DynamicResource ThemeTextSecondary}"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" x:Name="PasswordBox"
                   Text="{Binding Password, Mode=TwoWay}"
                   PasswordChar="•"
                   FontSize="14" Padding="12,10"/>
          <ToggleButton Grid.Column="1" Content="👁" Padding="8,6"
                        Margin="4,0,0,0"
                        IsChecked="{Binding IsPasswordVisible}"/>
        </Grid>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="Подтверждение:" FontSize="13"
                   Foreground="{DynamicResource ThemeTextSecondary}"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" x:Name="ConfirmBox"
                   Text="{Binding ConfirmPassword, Mode=TwoWay}"
                   PasswordChar="•"
                   FontSize="14" Padding="12,10"/>
          <ToggleButton Grid.Column="1" Content="👁" Padding="8,6"
                        Margin="4,0,0,0"
                        IsChecked="{Binding IsConfirmVisible}"/>
        </Grid>
      </StackPanel>

      <Border Background="{DynamicResource ThemeCardBackground}"
              CornerRadius="8" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Требования к паролю:" FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeTextSecondary}"/>

          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="✓" FontSize="13"
                         Foreground="{DynamicResource ThemeSuccessText}"
                         IsVisible="{Binding HasMinLength}"/>
              <TextBlock Text="—" FontSize="13"
                         Foreground="{DynamicResource ThemeMutedText}"
                         IsVisible="{Binding !HasMinLength}"/>
              <TextBlock Text="Длина 8–128 символов" FontSize="12"
                         Foreground="{DynamicResource ThemeTextSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="✓" FontSize="13"
                         Foreground="{DynamicResource ThemeSuccessText}"
                         IsVisible="{Binding HasUpper}"/>
              <TextBlock Text="—" FontSize="13"
                         Foreground="{DynamicResource ThemeMutedText}"
                         IsVisible="{Binding !HasUpper}"/>
              <TextBlock Text="Заглавная буква (A–Z)" FontSize="12"
                         Foreground="{DynamicResource ThemeTextSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="✓" FontSize="13"
                         Foreground="{DynamicResource ThemeSuccessText}"
                         IsVisible="{Binding HasLower}"/>
              <TextBlock Text="—" FontSize="13"
                         Foreground="{DynamicResource ThemeMutedText}"
                         IsVisible="{Binding !HasLower}"/>
              <TextBlock Text="Строчная буква (a–z)" FontSize="12"
                         Foreground="{DynamicResource ThemeTextSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="✓" FontSize="13"
                         Foreground="{DynamicResource ThemeSuccessText}"
                         IsVisible="{Binding HasDigit}"/>
              <TextBlock Text="—" FontSize="13"
                         Foreground="{DynamicResource ThemeMutedText}"
                         IsVisible="{Binding !HasDigit}"/>
              <TextBlock Text="Цифра (0–9)" FontSize="12"
                         Foreground="{DynamicResource ThemeTextSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="✓" FontSize="13"
                         Foreground="{DynamicResource ThemeSuccessText}"
                         IsVisible="{Binding HasSpecial}"/>
              <TextBlock Text="—" FontSize="13"
                         Foreground="{DynamicResource ThemeMutedText}"
                         IsVisible="{Binding !HasSpecial}"/>
              <TextBlock Text="Специальный символ (!@#$%^&amp;*)" FontSize="12"
                         Foreground="{DynamicResource ThemeTextSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="✓" FontSize="13"
                         Foreground="{DynamicResource ThemeSuccessText}"
                         IsVisible="{Binding PasswordsMatch}"/>
              <TextBlock Text="—" FontSize="13"
                         Foreground="{DynamicResource ThemeMutedText}"
                         IsVisible="{Binding !PasswordsMatch}"/>
              <TextBlock Text="Пароли совпадают" FontSize="12"
                         Foreground="{DynamicResource ThemeTextSecondary}"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="4" Margin="0,6,0,0">
            <TextBlock Text="Надёжность:" FontSize="11"
                       Foreground="{DynamicResource ThemeTextSecondary}"/>
            <ProgressBar Value="{Binding PasswordStrength}"
                         Maximum="100" Height="6" CornerRadius="3"/>
            <TextBlock Text="{Binding StrengthText}" FontSize="11"
                       Foreground="{DynamicResource ThemeTextSecondary}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="⚠" FontSize="11"
                   Foreground="{DynamicResource ThemeWarningText}"
                   VerticalAlignment="Center"/>
        <TextBlock Text="Действие будет записано в журнал аудита."
                   FontSize="11"
                   Foreground="{DynamicResource ThemeTextSecondary}"/>
      </StackPanel>

      <Border Background="{DynamicResource StatusRed}" CornerRadius="6"
              Padding="10,6" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                   Foreground="{DynamicResource ThemeTextOnElevated}"
                   TextWrapping="Wrap"/>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="12"
                  HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Content="Отмена" Width="110"
                Command="{Binding CancelCommand}"
                Classes="Secondary"/>
        <Button Content="🔑 Сменить пароль" Width="170"
                Command="{Binding ConfirmCommand}"
                IsEnabled="{Binding IsValid}"
                Classes="AccentButton"/>
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
