# Copy to .env for local development. Never put real secrets here.
# Deployment happens in the corporate network; production values are set there
# and must never be committed to this project (D-038: repo is under Git, secrets stay out).

APP_ENV=local
APP_NAME=support-hub
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost

# PostgreSQL (used by deploy/docker-compose.yml and the backend)
POSTGRES_DB=support_hub
POSTGRES_USER=support_hub
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql+asyncpg://support_hub:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/support_hub

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# --- Reserved for later stages (placeholders only, no secrets) ---
# Stage 5 (attachments): object storage is provided by the corporate network;
# no local MinIO. Settings MINIO_* live in app/config.py as a foundation.
# Stage 5 (Tag / Mattermost Bot integration):
# MATTERMOST_BOT_INTERNAL_BASE_URL=http://mattermost-bot:8080
# BOT_TO_SUPPORT_HUB_TOKEN=SET_OUTSIDE_PROJECT
# SUPPORT_HUB_TO_BOT_TOKEN=SET_OUTSIDE_PROJECT
# Stage 6 (AI Orchestrator = RAG Assistant Gateway, реальный контракт D-043):
# ключ выдаёт команда интеграции, реальный base URL — вне проекта.
# AI_ORCHESTRATOR_BASE_URL=https://ai-gateway.example.invalid
# SUPPORT_HUB_TO_AI_TOKEN=SET_OUTSIDE_PROJECT
# Stage 7 (Keycloak operator SSO):
# OIDC_ISSUER_URL=https://keycloak.example.invalid/realms/REPLACE_ME
# OIDC_CLIENT_ID=support-hub
# OIDC_CLIENT_SECRET=SET_OUTSIDE_PROJECT
# OIDC_AUDIENCE=REPLACE_ME
