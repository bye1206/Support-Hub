# Copy to .env for local development. Never commit real secrets.
APP_ENV=local
APP_NAME=support-hub
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost

# PostgreSQL
POSTGRES_DB=support_hub
POSTGRES_USER=support_hub
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql+asyncpg://support_hub:CHANGE_ME_LOCAL_ONLY@postgres:5432/support_hub

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY
MINIO_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
MINIO_SECURE=false
MINIO_BUCKET=support-hub-files

# Keycloak / OIDC (operator authentication)
OIDC_ISSUER_URL=https://keycloak.example.invalid/realms/REPLACE_ME
OIDC_CLIENT_ID=support-hub
OIDC_CLIENT_SECRET=SET_OUTSIDE_GIT
OIDC_AUDIENCE=REPLACE_ME

# Bot <-> Support Hub service credentials
BOT_TO_SUPPORT_HUB_TOKEN=SET_OUTSIDE_GIT
SUPPORT_HUB_TO_BOT_TOKEN=SET_OUTSIDE_GIT

# Existing Mattermost Bot internal API. Tag credentials belong to the Bot, not Support Hub.
MATTERMOST_BOT_INTERNAL_BASE_URL=http://mattermost-bot:8080

# AI Orchestrator — actual URL/contract must be confirmed
AI_ORCHESTRATOR_BASE_URL=https://ai-orchestrator.example.invalid
SUPPORT_HUB_TO_AI_TOKEN=SET_OUTSIDE_GIT
AI_TO_SUPPORT_HUB_TOKEN=SET_OUTSIDE_GIT

# Attachments — proposed defaults; limits must be confirmed
ATTACHMENTS_MAX_SIZE_BYTES=10485760
ATTACHMENTS_MAX_COUNT_PER_MESSAGE=5
ATTACHMENTS_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp

# Session duration is a confirmed business rule; keep fixed at 3 hours for MVP.
CONVERSATION_SESSION_DURATION_SECONDS=10800
